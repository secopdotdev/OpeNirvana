#CROWDSEC_MEM_LIMIT=256m
#AUTHENTIK_SERVER_MEM_LIMIT=768m
#AUTHENTIK_WORKER_MEM_LIMIT=768m
#NEXTCLOUD_MEM_LIMIT=512m
#WAZUH_INDEXER_MEM_LIMIT=2g
#WAZUH_INDEXER_JVM_HEAP=1g
#WAZUH_MANAGER_MEM_LIMIT=512m
#WAZUH_DASHBOARD_MEM_LIMIT=256m
#FALCO_MEM_LIMIT=256m
#ZEEK_MEM_LIMIT=512m
#ZEEK_WORKER_COUNT=1
#GLUETUN_MEM_LIMIT=256m
#PROWLARR_MEM_LIMIT=256m
#RADARR_MEM_LIMIT=256m
#SONARR_MEM_LIMIT=256m
#LIDARR_MEM_LIMIT=256m
#FLARESOLVERR_MEM_LIMIT=256m
#QBIT_MEM_LIMIT=512m
#JELLYFIN_MEM_LIMIT=1g
#JELLYSEERR_MEM_LIMIT=256m
#NTFY_MEM_LIMIT=128m
#TANDOOR_MEM_LIMIT=256m
#VIKUNJA_MEM_LIMIT=256m
#AFFINE_MEM_LIMIT=512m
#COTURN_MEM_LIMIT=256m
#N8N_MEM_LIMIT=256m

# ==========================================================
# TAILSCALE
# Authkey: Tailscale admin → Settings → Auth keys → Generate
# Tag the key with tag:ingress and tag:docker.
# ==========================================================
TAILSCALE_AUTHKEY=
TAILSCALE_INGRESS_HOSTNAME=ingress    # becomes ingress.TAILNET_FQDN

# ==========================================================
# CLOUDFLARE (DNS-01 challenge + dynamic CF IP range plugin)
# Token needs: Zone:Read + DNS:Edit on the PUBLIC_FQDN zone.
# Create at: dash.cloudflare.com → My Profile → API Tokens
# ==========================================================
CLOUDFLARE_API_TOKEN=

# ==========================================================
# POSTGRES (shared cluster)
# All app databases are provisioned automatically by
# templates/postgres/init.d/00-create-app-dbs.sh using the
# *_DB_NAME/*_DB_USER/*_DB_PASSWORD triples below.
# GOTCHA: This init script only runs on a FRESH data volume.
#   If you need to add a DB after first boot, run gen-secrets.sh
#   with --apply which runs ALTER USER for all known users.
# ==========================================================
POSTGRES_VERSION=pg16
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=          # gen-secrets.sh fills this
POSTGRES_INITDB_ARGS=--data-checksums --locale=C.UTF-8 --encoding=UTF8
POSTGRES_BACKUP_RETENTION_DAYS=14

# ==========================================================
# REDIS (shared instance, logical DB per app)
# DB assignments are fixed — do not renumber after first run
# or sessions/cache for the affected app will be invalidated.
# ==========================================================
REDIS_PASSWORD=                       # gen-secrets.sh fills this
REDIS_APPENDONLY=yes
REDIS_DB_AUTHENTIK=0
REDIS_DB_CADDY_CACHE=1
REDIS_DB_AFFINE=2
REDIS_DB_NEXTCLOUD=3
REDIS_DB_IMMICH=4

# ==========================================================
# CADDY
# ==========================================================
CADDY_METRICS_ENABLED=true
CADDY_LOG_LEVEL=INFO

# ==========================================================
# SUBDOMAINS — each becomes <sub>.PUBLIC_FQDN and <sub>.TAILNET_FQDN
# Change a value here to remap a service to a different hostname.
# To add a new service: define (backend-*) in the Caddyfile, add a
# matcher + handle in both site blocks, then add its var below.
# GOTCHA: Subdomains that don't exist in Cloudflare DNS will 404
#   until you add a CNAME pointing to your PUBLIC_FQDN wildcard.
#   Caddy's wildcard cert covers all of them automatically.
# ==========================================================
# Core stack
AUTHENTIK_SUBDOMAIN=auth
WAZUH_SUBDOMAIN=wazuh
NEXTCLOUD_SUBDOMAIN=cloud
# Media stack (profile: media)
PROWLARR_SUBDOMAIN=prowlarr
RADARR_SUBDOMAIN=movie
SONARR_SUBDOMAIN=tv
LIDARR_SUBDOMAIN=music
QBIT_SUBDOMAIN=tor
JELLYFIN_SUBDOMAIN=stream
JELLYSEERR_SUBDOMAIN=more
FLARESOLVERR_SUBDOMAIN=flare
# Productivity stack (profile: apps)
NTFY_SUBDOMAIN=ping
TANDOOR_SUBDOMAIN=food
VIKUNJA_SUBDOMAIN=todo
AFFINE_SUBDOMAIN=note
# Ops stack
CROWDSEC_SUBDOMAIN=crowd
DOCKHAND_SUBDOMAIN=dock
# Media/photo library
IMMICH_SUBDOMAIN=pic
# Observability dashboards
FALCO_SUBDOMAIN=sec
ZEEK_SUBDOMAIN=net
# Workflow automation
N8N_SUBDOMAIN=n8n

# ==========================================================
# CROWDSEC
# BOUNCER_KEY: generated automatically by gen-secrets.sh --apply.
# ENROLL_KEY: optional, from console.crowdsec.net for cloud sync.
# ==========================================================
CROWDSEC_BOUNCER_KEY=                 # gen-secrets.sh --apply fills this
CROWDSEC_ENROLL_KEY=

# ==========================================================
# WAZUH
# GOTCHA: Indexer passwords must satisfy complexity:
#   8+ chars, 1+ uppercase, 1+ lowercase, 1+ digit, 1+ special.
#   gen-secrets.sh appends _W to meet this requirement.
# GOTCHA: Changing indexer passwords on a live stack requires
#   running securityadmin.sh against the OpenSearch cluster —
#   gen-secrets.sh --apply does this automatically.
# ==========================================================
WAZUH_VERSION=4.9.2
WAZUH_API_PASSWORD=                   # gen-secrets.sh fills this
WAZUH_INDEXER_ADMIN_PASSWORD=         # gen-secrets.sh fills this
WAZUH_INDEXER_KIBANASERVER_PASSWORD=  # gen-secrets.sh fills this
WAZUH_INDEXER_RETENTION_DAYS=45

# ==========================================================
# FALCO (runtime container security)
# modern_ebpf requires kernel 5.8+. Fallback: ebpf (kernel 4.14+).
# ==========================================================
FALCO_DRIVER=modern_ebpf

# ==========================================================
# ZEEK (network security monitoring)
# auto = monitor all non-loopback interfaces; or comma-list: eth0,eth1
# ==========================================================
ZEEK_INTERFACES=auto

# ==========================================================
# AUTHENTIK
# OUTPOST_TOKEN: obtained after first run:
#   docker exec authentik-server ak shell
#   >>> from authentik.providers.proxy.models import ProxyProvider
#   >>> Token.objects.get(identifier__startswith="ak-outpost").key
# ==========================================================
AUTHENTIK_VERSION=2024.12.2
AUTHENTIK_SECRET_KEY=                 # gen-secrets.sh fills this
AUTHENTIK_BOOTSTRAP_PASSWORD=        # gen-secrets.sh fills this
AUTHENTIK_BOOTSTRAP_TOKEN=           # gen-secrets.sh fills this
AUTHENTIK_OUTPOST_TOKEN=             # must be set manually after first run
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=               # gen-secrets.sh fills this
AUTHENTIK_REDIS_DB=${REDIS_DB_AUTHENTIK}

# ==========================================================
# NEXTCLOUD
# ==========================================================
NEXTCLOUD_VERSION=30
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=            # gen-secrets.sh fills this
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=               # gen-secrets.sh fills this

# ==========================================================
# COTURN (TURN/STUN for Nextcloud Talk WebRTC)
# After first deploy, configure Talk via:
#   docker exec --user www-data nextcloud php occ talk:turn:add \
#     --secret $COTURN_SECRET turn $SERVER_IP:3478 udp,tcp
# Firewall ports 3478/udp+tcp and 49152-49200/udp must be open
# (docker-host-config.sh handles this via UFW).
# ==========================================================
COTURN_SECRET=                        # gen-secrets.sh fills this

# ==========================================================
# MEDIA STACK                          (profile: media)
# Enable:  docker compose --profile media up -d
# Disable: docker compose --profile media down
#
# GOTCHA: MEDIA_PATH and DOWNLOADS_PATH must exist on the host
#   before starting the stack. docker-host-config.sh creates
#   them but they need physical storage mounted there.
# GOTCHA: GPU transcoding (/dev/dri) requires the host to have
#   a compatible GPU and drivers (intel-media-va-driver for Intel,
#   libva-mesa-driver for AMD, or nvidia drivers for NVIDIA).
# ==========================================================

# ProtonVPN WireGuard — from ProtonVPN dashboard → WireGuard config download.
# WIREGUARD_PRIVATE_KEY: the PrivateKey line from the WG config.
PROTONVPN_WIREGUARD_PRIVATE_KEY=
PROTONVPN_SERVER_COUNTRIES=Netherlands
PROTONVPN_PORT_FORWARDING=off          # set to "on" to enable PF for seeding

# Host paths for media files (must exist, owned PUID:PGID)
MEDIA_PATH=/mnt/media
DOWNLOADS_PATH=/mnt/HDD/downloads

# qBittorrent WebUI port — must match VPN_PORT_FORWARDING_UP_COMMAND in gluetun
QBIT_WEBUI_PORT=8080

# Image versions (omit to use latest)
JELLYFIN_VERSION=latest
JELLYSEERR_VERSION=latest

# ==========================================================
# PRODUCTIVITY STACK                   (profile: apps)
# Enable:  docker compose --profile apps up -d
# Disable: docker compose --profile apps down
#
# Includes: ntfy, Tandoor, Vikunja, AFFiNE
#
# GOTCHA: All productivity DB passwords are generated by
#   gen-secrets.sh. Run it before first deploy.
# GOTCHA: Tandoor's SECRET_KEY must not change after first run —
#   it encrypts session data. gen-secrets.sh never overwrites it.
# GOTCHA: Vikunja's JWT_SECRET must not change after first run —
#   it signs user tokens. Changing it logs out all users.
# GOTCHA: AFFiNE's AFFINE_SERVER_EXTERNAL_URL must exactly match
#   the URL users access it from (protocol + hostname). Mismatch
#   breaks CORS and WebSocket connections (editor won't load).
# ==========================================================

# Image versions (omit to use latest/stable)
NTFY_VERSION=latest
TANDOOR_VERSION=latest
VIKUNJA_VERSION=latest
AFFINE_VERSION=stable

# Tandoor
TANDOOR_DB_NAME=tandoor
TANDOOR_DB_USER=tandoor
TANDOOR_DB_PASSWORD=                  # gen-secrets.sh fills this
TANDOOR_SECRET_KEY=                   # gen-secrets.sh fills this — do not change after first run

# Vikunja
VIKUNJA_DB_NAME=vikunja
VIKUNJA_DB_USER=vikunja
VIKUNJA_DB_PASSWORD=                  # gen-secrets.sh fills this
VIKUNJA_JWT_SECRET=                   # gen-secrets.sh fills this — do not change after first run

# AFFiNE
AFFINE_DB_NAME=affine
AFFINE_DB_USER=affine
AFFINE_DB_PASSWORD=                   # gen-secrets.sh fills this

# ==========================================================
# DOCKHAND (container monitoring + management dashboard)
# ==========================================================
DOCKHAND_ENCRYPTION_KEY=                   # gen-secrets.sh fills this
DOCKHAND_MEM_LIMIT=256m

# ==========================================================
# IMMICH (self-hosted photo + video library)
# GOTCHA: IMMICH_DB_PASSWORD must not change after first run —
#   Immich stores it in the database connection string.
# ==========================================================
IMMICH_VERSION=release
IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=                        # gen-secrets.sh fills this
REDIS_DB_IMMICH=4
IMMICH_SERVER_MEM_LIMIT=2g
IMMICH_ML_MEM_LIMIT=2g

# ==========================================================
# N8N (workflow automation)                  (profile: apps)
# GOTCHA: N8N_ENCRYPTION_KEY is immutable after first run —
#   it encrypts stored credentials. gen-secrets.sh never
#   overwrites it once set.
# ==========================================================
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=                           # gen-secrets.sh fills this
N8N_ENCRYPTION_KEY=                        # gen-secrets.sh fills this — do not change after first run
