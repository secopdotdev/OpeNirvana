#GLUETUN_MEM_LIMIT=256m
#PROWLARR_MEM_LIMIT=256m
#RADARR_MEM_LIMIT=256m
#SONARR_MEM_LIMIT=256m
#LIDARR_MEM_LIMIT=256m
#FLARESOLVERR_MEM_LIMIT=256m
#QBIT_MEM_LIMIT=512m
