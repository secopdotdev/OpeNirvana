{
    admin 127.0.0.1:2019
    email {$ADMIN_EMAIL}
    # Unordered plugin handlers — pin to the standard pipeline so named
    # snippets can import them outside of explicit route blocks.
    order crowdsec first
    order coraza_waf after crowdsec
    log default {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 10
            roll_keep_for 720h
        }
        format json
        level {$CADDY_LOG_LEVEL}
    }

    metrics

    servers {
        protocols h1 h2 h3
        trusted_proxies cloudflare {
            interval 12h
            timeout 15s
        }
    }

    cache {
        ttl 10m
        api {
            basepath /souin-api
        }
        redis {
            url redis://:{$REDIS_PASSWORD}@redis:6379/{$REDIS_DB_CADDY_CACHE}
        }
    }

    crowdsec {
        api_url http://crowdsec:8080
        api_key {$CROWDSEC_BOUNCER_KEY}
        ticker_interval 15s
    }
}

# Pull named-snippet definitions from individual files under snippets/.
import snippets/*.caddy

# ==============================================================
# Backend snippets — one per routed service.
#
# Adding a service:
#   1. Define (backend-myservice) here with the upstream only.
#      Authentik auth is enforced by the bare forward_auth directive at the
#      site level (runs before handle blocks). Do NOT add import
#      authentik-forward-auth inside backend snippets.
#   2. Add @myservice matcher + handle block in BOTH site blocks below.
#   3. Add MYSERVICE_SUBDOMAIN=foo to .env and to caddy's environment
#      block in docker-compose.yml.
#   4. If the service is on a new network, ensure tailscale-ingress is
#      also connected to that network (caddy shares tailscale-ingress's
#      netns so it inherits its reachability).
# ==============================================================

# Authentik SSO — the identity provider itself; exempt from the global gate.
(backend-authentik) {
    reverse_proxy authentik-server:9000
}

# Wazuh dashboard — OpenSearch Dashboards with self-signed cert.
(backend-wazuh) {
    reverse_proxy https://wazuh-dashboard:5601 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

# Nextcloud — file sync + collaboration.
# Well-known redirects are required by CalDAV/CardDAV clients.
(backend-nextcloud) {
    redir /.well-known/carddav /remote.php/dav 301
    redir /.well-known/caldav  /remote.php/dav 301

    reverse_proxy nextcloud:80
}

