# ════════════════════════════════════════════════════════════════════
#   GLOBAL — host identity, paths, and cross-stack settings
# ════════════════════════════════════════════════════════════════════
COMPOSE_PROJECT_NAME=stack            # Docker Compose project name prefix. All scripts reference
                                       # containers by their explicit container_name fields (not this
                                       # prefix), so it is safe to leave as 'stack'.

# ── Deployment modularity (which services deploy) — ADR-0015 ────────────────────────
# run.sh resolves the final service list via scripts/profiles.py (the SSoT reader of
# profiles.toml): (union of STACK_PROFILES ∪ core) + SERVICE_ENABLE − SERVICE_DISABLE,
# dependency-checked (HARD gap → abort, SOFT gap → warn). `core` infra is always forced
# on and cannot be disabled. Inspect/validate offline:
#   python3 scripts/profiles.py --list                      # full catalog (profiles + bundles)
#   python3 scripts/profiles.py --check --profiles "<set>"  # dependency doctor (exits ≠0 on HARD)
#   python3 scripts/profiles.py --resolve --profiles "<set>" --disable <svc>   # preview service list
#
# STACK_PROFILES: comma-separated FINE profile names OR bundle names. Bundles expand to
# their fine profiles (observability, security, productivity, media). Default below = full
# functional stack (OOTB / one-liner). Trim it to deploy a tailored subset, e.g.
#   STACK_PROFILES=observability,files,tasks         # bundles + a couple apps
#   STACK_PROFILES=metrics,viz,logs,netmon,files     # fine profiles
STACK_PROFILES=netmon,runtime-sec,metrics,exporters,logs,viz,container-mgmt,home,automation,notify,files,talk,photos,notes,tasks,recipes,vpn,downloads,indexers,movies,tv,audio,stream,requests,captcha
# SERVICE_ENABLE: comma-separated INDIVIDUAL service short-names to force ON beyond the
# selected profiles/bundles (cherry-pick a single service), e.g. SERVICE_ENABLE=dashy,ntfy
SERVICE_ENABLE=
# SERVICE_DISABLE: comma-separated service short-names to force OFF within the selected
# profiles/bundles, e.g. SERVICE_DISABLE=lidarr. Refused (fail-closed abort) for `core`
# services and for any service another ENABLED service HARD-depends on.
SERVICE_DISABLE=
# RESOURCE_TIER: host size tier. run.sh auto-detects from /proc/meminfo and writes this
# ONLY IF BLANK (a human value always wins). Thresholds: ≤12 GB→MICRO, ≤20→LOW, ≤44→MED,
# ≤96→HIGH, else MAX. Advisory — it does NOT change which services run; it tells you which
# optional per-service *_MEM_LIMIT preset block (PERFORMANCE TIERING, below) to uncomment,
# and run.sh warns if your active memory ceiling exceeds host RAM. Leave blank to auto-detect.
RESOURCE_TIER=
PUID=1010                             # UID of the host user owning bind-mounted volumes (admin).
                                       # Must match what docker-host-config.sh creates; mismatches
                                       # cause permission errors on /dock/conf and /dock/data paths.
PGID=1010                             # GID of the host group owning bind-mounted volumes (media).
                                       # Same constraint as PUID.
TZ=America/Chicago                    # IANA timezone. Affects log timestamps, cron containers, and
                                       # scheduled jobs. Find your value: timedatectl list-timezones
PUBLIC_FQDN=yourdomain.com            # The zone Cloudflare manages. Used everywhere: TLS cert subject,
                                       # Caddy site blocks, Authentik issuer URLs, and all *_SUBDOMAIN
                                       # expansions. Every *.PUBLIC_FQDN subdomain is covered by the
                                       # wildcard cert Caddy provisions via Cloudflare DNS-01.
TAILNET_FQDN=your-tailnet.example      # Your Tailscale tailnet DNS name. From Tailscale admin → DNS.
                                       # Services are reachable at <sub>.TAILNET_FQDN via Tailscale in
                                       # addition to the public *.PUBLIC_FQDN addresses.
ADMIN_EMAIL=you@yourdomain.com        # Used for Let's Encrypt TLS cert registration via Caddy ACME.

# ── Docker Hub authentication (lifts the anonymous pull-rate limit) ──────────────────
# The stack pulls ~50 images from Docker Hub; anonymous pulls hit 100/6h and abort
# `compose up`. docker-host-config.sh:configure_docker_registry_auth() logs svc-user
# and the run.sh operator into docker.io with these creds (idempotent; if blank, an
# existing manual login is preserved). Use a PULL-SCOPED access token, NOT your password
# — hub.docker.com → Account Settings → Personal access tokens → "Read-only". This is
# cleartext-at-bootstrap by necessity: OpenBao's own image must be pulled before it can
# serve secrets (chicken/egg), so registry creds cannot live in the vault.
DOCKERHUB_USERNAME=                    # Docker Hub account name; blank = anonymous pulls (rate-limited).
DOCKERHUB_TOKEN=                       # Pull-scoped Docker Hub access token (NOT the account password).

# Host paths (must match docker-host-config.sh tree)
DOCK_CONF=/dock/conf                  # Service config files. Each service gets /dock/conf/<service>/.
DOCK_DATA=/dock/data                  # Persistent service data (databases, uploads, media libraries).
DOCK_DB=/dock/db                      # Postgres and Redis data directories.
DOCK_TAIL=/dock/tail                  # Tailscale state directories per service (if any).

# External IPs outside Cloudflare permitted to reach *.PUBLIC_FQDN
# Useful for a home/office IP; leave blank to allow no extra IPs.
EXTRA_ALLOWED_IP=                     # Optional. Caddy's IP allowlist grants this IP trusted-proxy
                                       # status (bypasses Cloudflare IP range check). Set to your WAN
                                       # IP if hitting the stack from a network not routed via Cloudflare.

# ════════════════════════════════════════════════════════════════════
#   REQUIRED — Tailscale
#   Mesh VPN ingress — exposes the stack to your devices without
#   opening firewall ports. Generate a reusable auth key tagged with
#   tag:ingress and tag:docker at tailscale.com/admin.
#   Docs: https://tailscale.com/kb/1085/auth-keys
# ════════════════════════════════════════════════════════════════════
TAILSCALE_AUTHKEY=                    # Reusable auth key. Must carry tags: tag:ingress and tag:docker.
                                       # The container registers itself and auto-approves on first boot.
TAILSCALE_INGRESS_HOSTNAME=ingress    # becomes ingress.TAILNET_FQDN — the Tailscale device name for
                                       # the ingress container. Must be unique in your tailnet.

# ════════════════════════════════════════════════════════════════════
#   Tailscale API — OAuth credentials for ACL + key provisioning
#   Create an OAuth client at: https://login.tailscale.com/admin/settings/oauth
#   Required scopes: acl:write, devices:read, keys:write
#   Run AFTER granting scopes: python3 scripts/set-auth.py tailscale
#   NOTE: Run set-auth.py tailscale BEFORE docker compose up so that
#   TAILSCALE_AUTHKEY is populated with a properly tagged key.
#   Docs: https://tailscale.com/kb/1215/oauth-clients
# ════════════════════════════════════════════════════════════════════
TAILSCALE_OAUTH_CLIENT_ID=            # OAuth client ID from Tailscale admin → Settings → OAuth clients
TAILSCALE_OAUTH_API_KEY=              # OAuth client secret — treat as a password, never commit plaintext

# ════════════════════════════════════════════════════════════════════
#   REQUIRED — Caddy
#   Reverse proxy + automatic TLS via Cloudflare DNS-01 challenge
#   (wildcard cert covers all *.PUBLIC_FQDN subdomains).
#   Token needs: Zone:Read + DNS:Edit on your PUBLIC_FQDN zone.
#   Create at: dash.cloudflare.com → My Profile → API Tokens
#   Docs: https://caddyserver.com/docs/automatic-https
# ════════════════════════════════════════════════════════════════════
CADDY_LOG_LEVEL=INFO                  # Log verbosity: DEBUG | INFO | WARN | ERROR
CADDY_METRICS_ENABLED=true            # Exposes Prometheus /metrics endpoint for Alloy scraping.
CADDY_JWT_SHARED_SECRET=              # 32+ char HMAC secret for M2M JWT bearer token verification (caddy-security)
                                       # Required for Caddy metrics in Grafana dashboards.
# REQUIRED. Used by Caddy DNS-01 ACME challenges and Cloudflare security
# event ingestion (maintain.py cloudflare).
# Scopes: Zone:Read + DNS:Edit + Zone:Analytics:Read
CLOUDFLARE_API_TOKEN=
# Optional. Read-only GitHub PAT (no scopes needed) used by check-versions.py to
# raise the GitHub API rate limit from 60/h to 5000/h — without it, a few of the
# ~45 image checks may report "latest unknown" per run. https://github.com/settings/tokens
GITHUB_TOKEN=

# ════════════════════════════════════════════════════════════════════
#   REQUIRED — Authentik
#   Identity provider + SSO gateway for all protected services.
#   Docs: https://docs.goauthentik.io
# ════════════════════════════════════════════════════════════════════
AUTHENTIK_BOOTSTRAP_PASSWORD=        # Initial password for the built-in 'akadmin' superuser.
                                       # Authentik sets this on first boot only. Change it immediately
                                       # after first login. gen-secrets.py fills this.
AUTHENTIK_BOOTSTRAP_TOKEN=           # CRITICAL API TOKEN. Authentik reads this on first boot and
                                       # creates it as a persistent API token in its database.
                                       # ALL automation scripts use this as their Bearer token:
                                       #   set-auth.py,
                                       #   check-stack.py, maintain.py, audit-user-access.py,
                                       #   gen-secrets.py (outpost fetch)
                                       # gen-secrets.py fills this. Do NOT change after first boot —
                                       # the token in Authentik's DB must match this value.

# AUTHENTIK_BOOTSTRAP_TOKEN_REVOKED -- machine-set by `set-auth.py revoke-bootstrap-token`.
# When "true", gen-secrets will NOT regenerate AUTHENTIK_BOOTSTRAP_TOKEN: first-run-and-
# revoke is permanent (re-issuing a long-lived superuser token re-opens the hole; ADR-0017).
# Leave blank on fresh installs.
AUTHENTIK_BOOTSTRAP_TOKEN_REVOKED=
# AUTHENTIK_API_TOKEN -- scoped Authentik service-account token. Broker-mintable via
# `python3 scripts/authentik-token-broker.py --apply` (ORM-minted via `ak shell`, non-expiring).
# RE-MINTABLE and force_set (NOT immutable) — re-run the broker after any Authentik DB reset.
# Preferred over AUTHENTIK_BOOTSTRAP_TOKEN by all admin API callers via
# resolve_admin_token() (utils_authentik_proxy.py, utils_authentik_oidc.py,
# utils_entra.py, audit-user-access.py, add-service.py) — ADR-0018.
AUTHENTIK_API_TOKEN=
AUTHENTIK_USER_NAME=                 # Username audited by audit-user-access.py. The
                                       # AUTHENTIK_USER_ACCESS_TOKEN below must belong to
                                       # this exact user; the script refuses to run on a
                                       # mismatch. Leave blank unless running the audit.
AUTHENTIK_USER_ACCESS_TOKEN=         # A per-user Authentik Access Token (Directory →
                                       # Tokens) for AUTHENTIK_USER_NAME. audit-user-access.py
                                       # authenticates AS this user to list the apps the
                                       # policy engine grants them. Not a privileged token.
                                       # The audit's ENTRA column additionally (optionally)
                                       # reuses ENTRA_READ_CLIENT_ID/SECRET + ENTRA_TENANT_ID below.
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_PASSWORD=               # gen-secrets.py fills this
AUTHENTIK_DB_USER=authentik
AUTHENTIK_OUTPOST_TOKEN=             # CRITICAL. The authentik-proxy container uses this token to
                                       # authenticate to the Authentik server and register as a proxy
                                       # outpost. Without it, the proxy won't connect and ALL services
                                       # protected by forward-auth will return 502.
                                       # Fetch automatically after first bring-up:
                                       #   python3 scripts/gen-secrets.py --apply
                                       # Manual fallback:
                                       #   docker exec authentik-server ak shell
                                       #   >>> from authentik.core.models import Token
                                       #   >>> Token.objects.get(identifier__startswith="ak-outpost").key
AUTHENTIK_SECRET_KEY=                # Django secret key. Must not change after first run — doing so
                                       # invalidates all active sessions and signed tokens.
                                       # gen-secrets.py fills this (50 random chars).
AUTHENTIK_VERSION=2026.2.3            # Pin to a tested version. Update deliberately:
                                       # change pin → docker compose pull → docker compose up -d → verify.

# ════════════════════════════════════════════════════════════════════
#   REQUIRED — PostgreSQL
#   Shared cluster. All databases are auto-provisioned on a FRESH
#   volume by templates/postgres/init.d/00-create-app-dbs.sh.
#   GOTCHA: The init script only runs on first boot.
#     To add a DB after first boot: run gen-secrets.py --apply,
#     which runs ALTER USER for all known users.
#   Docs: https://hub.docker.com/r/tensorchord/pgvecto-rs
# ════════════════════════════════════════════════════════════════════
POSTGRES_BACKUP_RETENTION_DAYS=14
POSTGRES_INITDB_ARGS="--data-checksums --locale=C.UTF-8 --encoding=UTF8"
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=          # gen-secrets.py fills this
POSTGRES_VERSION=pg16

# Per-service DB credentials (all provisioned automatically on first boot)
AFFINE_DB_NAME=affine
AFFINE_DB_PASSWORD=                   # gen-secrets.py fills this
AFFINE_DB_USER=affine
IMMICH_DB_NAME=immich
IMMICH_DB_PASSWORD=                   # gen-secrets.py fills this — do not change after first run
IMMICH_DB_USER=immich
N8N_DB_NAME=n8n
N8N_DB_PASSWORD=                      # gen-secrets.py fills this
N8N_DB_USER=n8n
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_PASSWORD=                # gen-secrets.py fills this
NEXTCLOUD_DB_USER=nextcloud
TANDOOR_DB_NAME=tandoor
TANDOOR_DB_PASSWORD=                  # gen-secrets.py fills this
TANDOOR_DB_USER=tandoor
VIKUNJA_DB_NAME=vikunja
VIKUNJA_DB_PASSWORD=                  # gen-secrets.py fills this
VIKUNJA_DB_USER=vikunja

# ════════════════════════════════════════════════════════════════════
#   REQUIRED — Redis
#   Shared instance with logical DBs per app.
#   GOTCHA: DB numbers are fixed — do not renumber after first run
#     or sessions/cache for the affected app will be invalidated.
#   Docs: https://redis.io/docs
# ════════════════════════════════════════════════════════════════════
REDIS_APPENDONLY=yes                  # Enables AOF persistence. Without this, Redis restarts discard
                                       # all cached data including Authentik sessions (users get logged out).
REDIS_DB_AFFINE=2
REDIS_DB_AUTHENTIK=0
REDIS_DB_CADDY_CACHE=1
REDIS_DB_CADDY_TLS=9                  # Isolated DB for Caddy TLS cert storage (caddy-storage-redis)
REDIS_DB_IMMICH=4
REDIS_DB_NEXTCLOUD=3
REDIS_DB_TANDOOR=6
REDIS_DB_VIKUNJA=7
REDIS_PASSWORD=                       # gen-secrets.py fills this

# ════════════════════════════════════════════════════════════════════
#   SUBDOMAINS
#   Each becomes <sub>.PUBLIC_FQDN (Cloudflare / public) and
#   <sub>.TAILNET_FQDN (Tailscale / private).
#
#   These vars are consumed by multiple automation scripts:
#     set-auth.py authentik — creates an Authentik proxy provider and
#       application for each subdomain that uses forward-auth.
#     add-service.sh         — creates the Cloudflare CNAME for new services.
#     check-stack.py         — cross-references DNS, Caddy backends, and auth.
#
#   GOTCHA: Changing a subdomain var after provisioning leaves an
#     orphaned CNAME in Cloudflare (check-stack.py will flag it as a
#     DNS orphan). Delete the old record manually in Cloudflare after
#     renaming, then re-run set-auth.py authentik to create the new one.
#   GOTCHA: Subdomains that don't exist in Cloudflare DNS will 404
#     until you add a CNAME pointing to caddy.PUBLIC_FQDN.
#     add-service.sh handles this automatically for new services.
#     Caddy's wildcard cert covers all of them automatically.
# ════════════════════════════════════════════════════════════════════

# Core (always active)
AUTHENTIK_SUBDOMAIN=auth              # Authentik SSO portal. Referenced by all scripts as the
                                       # Authentik base URL: https://auth.PUBLIC_FQDN
NEXTCLOUD_SUBDOMAIN=cloud

# Security tools
CROWDSEC_SUBDOMAIN=crowd
FALCO_SUBDOMAIN=sec
ZEEK_SUBDOMAIN=net

# Media (bundle: media — vpn,downloads,indexers,movies,tv,audio,stream,requests,captcha)
FLARESOLVERR_SUBDOMAIN=flare
JELLYFIN_SUBDOMAIN=stream
JELLYSEERR_SUBDOMAIN=more
LIDARR_SUBDOMAIN=music
PROWLARR_SUBDOMAIN=prowlarr
QBIT_SUBDOMAIN=tor
RADARR_SUBDOMAIN=movie
SONARR_SUBDOMAIN=tv

# Productivity & apps (profiles: files, photos, notes, tasks, recipes, automation, talk, notify)
AFFINE_SUBDOMAIN=note
IMMICH_SUBDOMAIN=pic
JANUS_SUBDOMAIN=gate                  # Janus WebRTC gateway admin API subdomain
N8N_SUBDOMAIN=n8n
NTFY_SUBDOMAIN=ping
TALK_SUBDOMAIN=talk                   # Nextcloud Talk High-Performance Backend signaling server
TANDOOR_SUBDOMAIN=food
VIKUNJA_SUBDOMAIN=todo

# Monitoring + launcher (always active)
GRAFANA_SUBDOMAIN=metrics             # metrics.PUBLIC_FQDN → Grafana dashboards
# Dashy is served at the apex (PUBLIC_FQDN itself), no subdomain needed.

# ╔══════════════════════════════════════════════════════════════════╗
# ║  AFFiNE — collaborative docs + whiteboards                     ║
# ║  Profile: apps  |  Docs: https://docs.affine.pro               ║
# ╚══════════════════════════════════════════════════════════════════╝
# OIDC is configured through the AFFiNE admin panel (not env vars).
# Run scripts/set-auth.py oidc first — it creates the Authentik OAuth2
# provider and prints the client ID, secret, and issuer URL.
# Then in AFFiNE Admin Panel → Settings → OAuth → OIDC OAuth provider:
#   {"args":{},"issuer":"<AFFINE_OIDC_ISSUER>","clientId":"<AFFINE_OIDC_CLIENT_ID>","clientSecret":"<AFFINE_OIDC_CLIENT_SECRET>"}
# Redirect URI to configure in Authentik (strict mode):
#   https://note.yourdomain.com/oauth/callback
AFFINE_OIDC_CLIENT_ID=               # from Authentik OAuth2 provider (set-auth.py oidc can provision this)
AFFINE_OIDC_CLIENT_SECRET=           # from Authentik OAuth2 provider
AFFINE_OIDC_ISSUER=                  # https://auth.yourdomain.com/application/o/<slug>/
AFFINE_VERSION=stable

# ╔══════════════════════════════════════════════════════════════════╗
# ║  CrowdSec — community-driven IPS + Caddy bouncer               ║
# ║  Docs: https://docs.crowdsec.net                                ║
# ╚══════════════════════════════════════════════════════════════════╝
CROWDSEC_BOUNCER_API_KEY=             # API key for Caddy's CrowdSec bouncer plugin. Without this,
                                       # the bouncer plugin fails to load and Caddy may not start.
                                       # Fetched automatically by gen-secrets.py --apply once CrowdSec
                                       # is running. Do not set manually — gen-secrets.py uses cscli
                                       # bouncers add to issue a key with a unique timestamped name.
CROWDSEC_ENROLL_API_KEY=              # Optional — from console.crowdsec.net. Enrolls this instance
                                       # in the CrowdSec cloud for threat intelligence sharing and
                                       # centralized management. Leave blank for standalone operation.

# ╔══════════════════════════════════════════════════════════════════╗
# ║  Entra ID + OIDC Group Provisioning — OPTIONAL                 ║
# ║  Federates Authentik with Microsoft Entra ID (Azure AD) as the ║
# ║  exclusive identity source. Works independently of the stack.  ║
# ║  Docs: scripts/set-auth.py --help                              ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── set-auth.py entra-* — Entra ID federation ─────────────────────────
# Quick start:
#   1. Set ENTRA_TENANT_ID and ENTRA_GLOBAL_AUTHENTIK_ACCESS_GROUP_NAME
#   2. pip install msal
#   3. python3 scripts/set-auth.py entra-setup
#
# --setup is fully idempotent — re-run after config changes.
# Uses device-code (browser) auth so it can patch the App Registration
# (Application.* Graph permissions required).
#
# Two App Registrations (can be the same registration initially):
#   READ  (ENTRA_READ_CLIENT_*):  GroupMember.ReadWrite.All, User.Read.All — group member enumeration
#   WRITE (ENTRA_WRITE_CLIENT_*): Application.Read.All, Application.ReadWrite.OwnedBy,
#                                  Group.ReadWrite.All, GroupMember.ReadWrite.All — group provisioning/nesting
#
# Recovery (restore local logins):
#   python3 scripts/undo-entra.py                     # full undo (disable source + restore password stage)
#   python3 scripts/undo-entra.py --just-binding      # remove only legacy gate binding, leave federation intact
ENTRA_GLOBAL_AUTHENTIK_ACCESS_GROUP_NAME=Global Access  # Entra security group whose members receive
                                       # transitive access to ALL services. Nested INTO every per-service
                                       # Authentik group by `entra-nesting`. Members are synced
                                       # transitively via Graph `/transitiveMembers`. Does not gate login —
                                       # any valid Entra tenant user can authenticate; service access is
                                       # governed entirely by group membership (direct or transitive).
ENTRA_APP_NAME=Authentik-Sync         # Display name for the Azure App Registration (READ role). --setup
                                       # looks up the existing registration by ENTRA_READ_CLIENT_ID on
                                       # re-runs, so changing this after that var is set is safe.
                                       # Changing it BEFORE ENTRA_READ_CLIENT_ID is set creates a new one.
ENTRA_READ_CLIENT_ID=                 # Filled automatically by --setup. Application (client) ID of the
                                       # READ App Registration. Used by entra-sync and audit-user-access.py
                                       # for non-interactive client-credentials auth to Microsoft Graph.
                                       # Falls back to ENTRA_WRITE_CLIENT_ID if unset (single-app setups).
ENTRA_READ_CLIENT_SECRET=             # Client secret for ENTRA_READ_CLIENT_ID (2-year expiry). Filled by
                                       # --setup. Re-run --setup to rotate without disruption.
ENTRA_WRITE_CLIENT_ID=                # Application (client) ID for write operations: group creation,
                                       # membership nesting (entra-nesting), and OIDC group provisioning.
                                       # Can be the same registration as ENTRA_READ_CLIENT_ID in simpler
                                       # setups. Write ops NEVER fall back to READ creds (least privilege).
ENTRA_WRITE_CLIENT_SECRET=            # Client secret for ENTRA_WRITE_CLIENT_ID.
ENTRA_LOCAL_LOGIN_RESTORED=           # State flag managed by scripts. Set to "true" by undo-entra.py when
                                       # local password logins are re-enabled; cleared back to "" by --setup.
                                       # Do not set manually — it tracks whether the Entra enforcement was
                                       # undone so --setup knows to re-apply phase 5.
ENTRA_SYNC_GROUPS=                    # Optional: comma-separated Entra group names to additionally sync
                                       # beyond the auto-discovered set. entra-sync always syncs the global
                                       # access group and all per-service groups derived from Authentik apps
                                       # at runtime. Only add groups here that are NOT created by set-auth.py
                                       # entra-* (e.g. pre-existing custom groups). Members are synced to the
                                       # Authentik group of the same name.
ENTRA_TENANT_ID=                      # Azure portal → Entra ID → Overview → Tenant ID (GUID format).
                                       # Shared by both READ and WRITE registrations (same tenant).
# ENTRA_ACCESS_GROUP — deprecated. Was the monolithic login-gate group in earlier versions.
# Set it only if undo-entra.py needs to remove a legacy entra-access-{group} policy binding.
# Leave blank on fresh installs — access is now governed per-service via nested Entra groups.
ENTRA_ACCESS_GROUP=

# ── set-auth.py oidc — per-service Authentik OIDC provider provisioning ─
# Creates OAuth2/OIDC providers in Authentik for each native-OIDC service
# (Jellyfin, Immich, Nextcloud, Tandoor, AFFiNE, Vikunja) and writes the
# generated client IDs, secrets, and issuer URLs back into .env.
# Optionally creates paired Entra security groups if ENTRA_WRITE_CLIENT_* vars are set.
#
# Quick start:
#   python3 scripts/set-auth.py oidc
#   python3 scripts/set-auth.py oidc --sync   # to also mirror group members
#
# ENTRA_WRITE_CLIENT_* is required to activate Entra group provisioning in oidc.
# If unset, set-auth.py oidc skips Entra steps but runs normally otherwise.
AUTHENTIK_GROUP_PREFIX=entra          # Prefix for Authentik per-service groups: {PREFIX}-{service-slug}.
                                       # Default produces groups like 'entra-jellyfin'. Must match the
                                       # prefix set-auth.py entra-* phase4b uses — changing this after groups
                                       # exist breaks the expression policies that gate service access.
ENTRA_GROUP_PREFIX=authentik          # Prefix for Entra per-service security groups: {PREFIX}-{service-slug}.
                                       # Default produces groups like 'authentik-jellyfin' in Azure. Add
                                       # users to these Entra groups to grant access; entra-sync mirrors
                                       # membership to the paired Authentik group.
ENTRA_PROFILE_INFIX=profile           # Middle segment for coarse-RBAC Entra category groups:
                                       # {ENTRA_GROUP_PREFIX}-{INFIX}-{category}. Default produces names
                                       # like 'authentik-profile-media', 'authentik-profile-netsec'.
                                       # Nested INTO the per-service groups for their category by entra-nesting.

# ╔══════════════════════════════════════════════════════════════════╗
# ║  Falco — runtime container security + syscall monitoring       ║
# ║  Docs: https://falco.org/docs                                  ║
# ╚══════════════════════════════════════════════════════════════════╝
# modern_ebpf requires kernel 5.8+; fallback: ebpf (kernel 4.14+).
FALCO_DRIVER=modern_ebpf

# ╔══════════════════════════════════════════════════════════════════╗
# ║  Grafana + Prometheus — metrics + health monitoring             ║
# ║  Docs: https://grafana.com/docs  |  https://prometheus.io/docs ║
# ╚══════════════════════════════════════════════════════════════════╝
# GOTCHA: GRAFANA_ADMIN_PASSWORD is the Grafana admin account. In
#   practice all logins go through Authentik SSO (header proxy);
#   the admin password is a break-glass fallback only.
# Provisioning files live in ${DOCK_CONF}/grafana/provisioning/.
# Copy templates/grafana/provisioning/ → ${DOCK_CONF}/grafana/provisioning/
# then install community dashboards with scripts/install-grafana-dashboards.sh.
GRAFANA_ADMIN_PASSWORD=              # gen-secrets.py fills this
GRAFANA_MEM_LIMIT=512m
PROMETHEUS_MEM_LIMIT=1g
PROMETHEUS_RETENTION=30d             # tsdb retention; ~1-3 GB/week per 40 containers
CADVISOR_MEM_LIMIT=512m
NODE_EXPORTER_MEM_LIMIT=128m
ALERTMANAGER_MEM_LIMIT=128m
TAILSCALE_INGRESS_MEM_LIMIT=256m     # tailnet ingress sidecar (shares netns with caddy)
# ALERTMANAGER_VERSION: pin to a specific Alertmanager release (default: v0.28.0).
# After updating, run: docker compose pull alertmanager && docker compose up -d alertmanager
ALERTMANAGER_VERSION=v0.32.1
# LOKI_VERSION:      https://github.com/grafana/loki/releases
# ALLOY_VERSION:     https://github.com/grafana/alloy/releases
LOKI_MEM_LIMIT=512m
LOKI_VERSION=3.5.0                    # HELD: 3.7.x ingester ring won't form with current loki.yml — needs config review before bumping
ALLOY_MEM_LIMIT=256m
ALLOY_VERSION=v1.16.1
DASHY_MEM_LIMIT=256m

# GID of the host 'docker' group — needed by Alloy to read /var/run/docker.sock
# and expose Docker container metrics in Grafana dashboards. Without this,
# container-level CPU/memory metrics will not appear. Detected automatically by
# gen-secrets.py from the running host; varies by distro and Docker installer.
DOCKER_GID=

# ── Image version pins ─────────────────────────────────────────────────────────
# Pin security-critical images so 'docker compose pull' never silently breaks them.
# Update deliberately: change the pin → pull → recreate → verify.
# CROWDSEC_VERSION:   https://github.com/crowdsecurity/crowdsec/releases
# FALCO_VERSION:      https://github.com/falcosecurity/falco/releases
# PROMETHEUS_VERSION: https://github.com/prometheus/prometheus/releases
# GRAFANA_VERSION:    https://github.com/grafana/grafana/releases
# DASHY_VERSION:      https://github.com/Lissy93/dashy/releases
# LOKI_VERSION:       https://github.com/grafana/loki/releases
# ALLOY_VERSION:      https://github.com/grafana/alloy/releases
CROWDSEC_VERSION=v1.7.8
FALCO_VERSION=0.43.1
PROMETHEUS_VERSION=v3.11.3
GRAFANA_VERSION=13.0.1
DASHY_VERSION=4.1.1

# ╔══════════════════════════════════════════════════════════════════╗
# ║  Immich — self-hosted photo + video library                    ║
# ║  Profile: apps  |  Docs: https://immich.app/docs               ║
# ╚══════════════════════════════════════════════════════════════════╝
# GOTCHA: IMMICH_DB_PASSWORD must not change after first run —
#   Immich stores the connection string in the database.
# OIDC: Run scripts/set-auth.py oidc to provision the Authentik provider
#   and push config via the Immich system-config API automatically.
#   Without IMMICH_API_KEY, set-auth.py oidc creates the Authentik provider
#   but cannot push config to Immich — you must configure OIDC in the
#   Immich admin UI manually using the printed client ID and secret.
#   Get the API key: Immich → Account Settings → API Keys → New API Key.
IMMICH_API_KEY=               # Admin API key for set-auth.py oidc auto-config. Optional but
                               # strongly recommended — without it OIDC must be configured manually.
IMMICH_ML_MEM_LIMIT=2g
IMMICH_OIDC_CLIENT_ID=        # Filled by set-auth.py oidc. Do not set manually.
IMMICH_OIDC_CLIENT_SECRET=    # Filled by set-auth.py oidc. Do not set manually.
IMMICH_OIDC_ISSUER=           # Filled by set-auth.py oidc. Do not set manually.
IMMICH_SERVER_MEM_LIMIT=2g
IMMICH_VERSION=v2.7.5                 # HELD at current: immich runs irreversible breaking DB migrations — review release notes + back up before bumping

# ╔══════════════════════════════════════════════════════════════════╗
# ║  Jellyfin + Jellyseerr — media server + request management     ║
# ║  Profile: media  |  Docs: https://jellyfin.org/docs            ║
# ╚══════════════════════════════════════════════════════════════════╝
# OIDC — Run scripts/set-auth.py oidc to auto-provision the Authentik
# provider, install the SSO plugin, and push config to Jellyfin.
# Without JELLYFIN_API_KEY, the SSO plugin must be installed and
# configured manually in the Jellyfin admin dashboard.
# Get the API key: Jellyfin admin → API Keys → + → copy the key.
JELLYFIN_API_KEY=               # Admin API key for set-auth.py oidc auto-config. Optional but
                                 # strongly recommended — without it OIDC must be configured manually.
JELLYFIN_OIDC_CLIENT_ID=        # Filled by set-auth.py oidc. Do not set manually.
JELLYFIN_OIDC_CLIENT_SECRET=    # Filled by set-auth.py oidc. Do not set manually.
JELLYFIN_OIDC_DISCOVERY_URL=    # Filled by set-auth.py oidc. Do not set manually.
JELLYFIN_VERSION=10.11.8ubu2404-ls30  # linuxserver tag (not upstream semver); bump via Docker Hub linuxserver/jellyfin tags
JELLYSEERR_VERSION=latest

# ╔══════════════════════════════════════════════════════════════════╗
# ║  n8n — workflow automation                                     ║
# ║  Profile: apps  |  Docs: https://docs.n8n.io                   ║
# ╚══════════════════════════════════════════════════════════════════╝
# GOTCHA: N8N_ENCRYPTION_KEY is immutable after first run —
#   it encrypts stored credentials. gen-secrets.py never overwrites it.
N8N_ENCRYPTION_KEY=                   # gen-secrets.py fills this — do not change after first run
# N8N_IMAGE is the authoritative, digest-pinned image ref (ADR-0009). Leave blank to
# use the compose default (n8nio/n8n@sha256:… == 2.21.7). To upgrade: pull the new tag,
# read its multi-arch index digest, and set N8N_IMAGE=n8nio/n8n@sha256:<new>.
N8N_IMAGE=                            # digest-pinned override; blank = compose default (2.21.7 digest)
N8N_VERSION=2.21.7                    # reference only — records which release the pinned digest maps to.

# ╔══════════════════════════════════════════════════════════════════╗
# ║  Nextcloud + Coturn + HPB                                      ║
# ║  Docs: https://docs.nextcloud.com  |  https://nextcloud.com    ║
# ╚══════════════════════════════════════════════════════════════════╝
NEXTCLOUD_ADMIN_PASSWORD=            # gen-secrets.py fills this
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_VERSION=30
# Hour (UTC, 0-23) at which Nextcloud's 4-hour low-load window for heavy
# background jobs (mimetype scans, preview cleanup, etc.) begins. Pick a
# local-night hour for your users: 8 = ~2-3 AM US-Central, ~3-4 AM Eastern.
# Applied by maintain.py nextcloud / maintain.py all.
NEXTCLOUD_MAINTENANCE_WINDOW_HOUR_UTC=8

# OIDC — Nextcloud authenticates via Authentik natively (no Caddy forward-auth).
# Step 1: In Authentik, create an OAuth2/OIDC Provider + Application.
#         Set the following Redirect URIs in the Authentik provider
#         (substitute your actual NEXTCLOUD_SUBDOMAIN.PUBLIC_FQDN values):
#           https://cloud.yourdomain.com/apps/user_oidc/code
#           https://cloud.your-tailnet.example/apps/user_oidc/code
# Step 2: Copy the Client ID and Secret from the Authentik provider, and
#         paste the discovery URL from Authentik → Application → OAuth2 Provider
#         → OpenID Configuration (the .well-known URL):
NEXTCLOUD_OIDC_CLIENT_ID=            # from Authentik OAuth2 provider
NEXTCLOUD_OIDC_CLIENT_SECRET=        # from Authentik OAuth2 provider
NEXTCLOUD_OIDC_DISCOVERY_URL=        # https://auth.yourdomain.com/application/o/<slug>/.well-known/openid-configuration
NEXTCLOUD_OIDC_PROVIDER_NAME=Authentik
# Step 3: After stack is healthy and the user_oidc app is installed in Nextcloud:
#   docker exec --user www-data nextcloud sh -c '
#     php occ user_oidc:provider "$NEXTCLOUD_OIDC_PROVIDER_NAME" \
#       --clientid="$NEXTCLOUD_OIDC_CLIENT_ID" \
#       --clientsecret="$NEXTCLOUD_OIDC_CLIENT_SECRET" \
#       --discoveryuri="$NEXTCLOUD_OIDC_DISCOVERY_URL" \
#       --check-bearer'

# Nextcloud admin API access — used by audit-user-access.py and any other tool that
# needs to query Nextcloud over HTTPS. Generate the app password manually:
#   1. Log in to your Nextcloud instance via a web browser as NEXTCLOUD_ADMIN_USER.
#   2. Click your user icon (top-right) → Personal settings.
#   3. Left sidebar → Security.
#   4. Scroll to "Devices & sessions" at the bottom.
#   5. In "App name" enter a label (e.g. "stack-audit").
#   6. Click "Create new app password" and copy the generated 64-char token.
# The token grants the same permissions as the user; do NOT commit it.
NEXTCLOUD_API_USERNAME=               # usually equals NEXTCLOUD_ADMIN_USER
NEXTCLOUD_API_KEY=                    # app password from the step above

# Coturn — TURN/STUN server for Nextcloud Talk WebRTC
# After first deploy, configure Talk via:
#   docker exec --user www-data nextcloud php occ talk:turn:add \
#     --secret $COTURN_SECRET turn $SERVER_IP:3478 udp,tcp
# Firewall ports 3478/udp+tcp and 49152-49200/udp must be open
# (docker-host-config.sh handles this via UFW).
COTURN_SECRET=                        # gen-secrets.py fills this

# HPB — Nextcloud Talk High-Performance Backend
# Deploys nextcloud-spreed-signaling (talk.PUBLIC_FQDN) and
# janus-gateway (gate.PUBLIC_FQDN) on the dedicated talk network.
#
# REQUIRED: Set HOST_PUBLIC_IP to this server's public (WAN) IP address.
# Janus uses nat_1_1_mapping so WebRTC ICE candidates advertise the correct IP.
# Setting this to an internal/Docker IP will cause WebRTC media to fail —
# clients will establish signaling but audio/video will not flow.
#
# After first deploy, configure Nextcloud Talk admin:
#   Settings → Talk → High-performance backend:
#     Signaling server URL: https://talk.PUBLIC_FQDN/
#     Shared secret:        NC_HPB_SHARED_SECRET value below
#
# Firewall: docker-host-config.sh opens 20000-20100/udp via UFW.
HOST_PUBLIC_IP=                       # your server's PUBLIC (WAN) IP — NOT the internal/Docker IP
JANUS_ADMIN_SECRET=                   # gen-secrets.py fills this
JANUS_API_SECRET=                     # gen-secrets.py fills this
JANUS_IMAGE=canyan/janus-gateway@sha256:80970d0b1c407222e2f88d7a6d31a16686fb9a5145a491b4b4d843ee40ee4ce1   # canyan = maintained community Janus image (meetecho/* unpublished); digest-pinned per ADR-0009
JANUS_MEM_LIMIT=512m
NC_HPB_BLOCK_KEY=                     # gen-secrets.py fills this (32 chars — AES-256 key, exact length required)
NC_HPB_HASH_KEY=                      # gen-secrets.py fills this (64 hex chars — HMAC-SHA256 key)
NC_HPB_SHARED_SECRET=                 # gen-secrets.py fills this — do not change after entering it in
                                       # Nextcloud Talk admin settings; Talk uses it to authenticate to the HPB.
SPREED_SIGNALING_MEM_LIMIT=256m
SPREED_SIGNALING_VERSION=latest

# ╔══════════════════════════════════════════════════════════════════╗
# ║  ntfy — push notification service                              ║
# ║  Profile: apps  |  Docs: https://docs.ntfy.sh                  ║
# ╚══════════════════════════════════════════════════════════════════╝
NTFY_VERSION=latest

# ╔══════════════════════════════════════════════════════════════════╗
# ║  Tandoor — recipe manager                                      ║
# ║  Profile: apps  |  Docs: https://docs.tandoor.dev              ║
# ╚══════════════════════════════════════════════════════════════════╝
# GOTCHA: TANDOOR_SECRET_KEY must not change after first run —
#   it encrypts session data. gen-secrets.py never overwrites it.
TANDOOR_SECRET_KEY=                   # gen-secrets.py fills this — do not change after first run
TANDOOR_VERSION=latest

# OIDC — Django allauth reads these natively at startup; no manual step required.
# The provider id "authentik" in SOCIALACCOUNT_PROVIDERS fixes the callback path —
# configure this exact redirect URI in Authentik (strict mode):
#   https://food.yourdomain.com/accounts/oidc/authentik/login/callback/
# DISCOVERY_URL is the full .well-known URL from the Authentik provider:
TANDOOR_OIDC_CLIENT_ID=              # from Authentik OAuth2 provider
TANDOOR_OIDC_CLIENT_SECRET=          # from Authentik OAuth2 provider
TANDOOR_OIDC_DISCOVERY_URL=          # https://auth.yourdomain.com/application/o/<slug>/.well-known/openid-configuration
TANDOOR_OIDC_PROVIDER_NAME=authentik
# After setting the above, restart Tandoor and OIDC is live:
#   docker compose up -d --no-deps --force-recreate tandoor

# ╔══════════════════════════════════════════════════════════════════╗
# ║  Vikunja — project management + to-do lists                   ║
# ║  Profile: apps  |  Docs: https://vikunja.io/docs               ║
# ╚══════════════════════════════════════════════════════════════════╝
# GOTCHA: VIKUNJA_JWT_SECRET must not change after first run —
#   it signs user tokens. Changing it logs out all users.
VIKUNJA_JWT_SECRET=                   # gen-secrets.py fills this — do not change after first run
VIKUNJA_VERSION=latest
# SSO lockdown: when true, local password login is disabled where safe so
# Authentik/Entra is the only interactive login. Vikunja honors VIKUNJA_AUTH_LOCAL_ENABLED
# directly; nextcloud/immich are handled by setup-sso-lockdown.py (OIDC-verified,
# idempotent). Revert per docs/runbooks/local-login-recovery.md.
SSO_LOCKDOWN_ENABLED=true

# OIDC — Vikunja reads these natively at startup; no manual step required.
# The provider key "AUTHENTIK" in the env var name fixes the redirect URI
# path to /auth/openid/authentik — configure that exact URI in Authentik.
# Redirect URIs to configure in Authentik (replace 'todo' if VIKUNJA_SUBDOMAIN changed):
#   https://todo.yourdomain.com/auth/openid/authentik
#   https://todo.your-tailnet.example/auth/openid/authentik
# AUTHURL is the Authentik issuer base URL (no .well-known suffix):
VIKUNJA_API_KEY=               # Admin API key for set-auth.py oidc auto-config. Optional but
                                # recommended — without it OIDC must be configured manually.
VIKUNJA_AUTH_LOCAL_ENABLED=true       # SECURITY: Keep true until OIDC is confirmed working end-to-end.
                                       # Set to false to enforce OIDC-only login (disables username/password
                                       # auth). Setting false prematurely before verifying OIDC will lock
                                       # all users out. Change with: docker compose up -d --no-deps vikunja
VIKUNJA_OIDC_AUTH_URL=               # https://auth.yourdomain.com/application/o/<slug>/
VIKUNJA_OIDC_CLIENT_ID=              # from Authentik OAuth2 provider (set-auth.py oidc can provision this)
VIKUNJA_OIDC_CLIENT_SECRET=          # from Authentik OAuth2 provider
VIKUNJA_OIDC_PROVIDER_NAME="authentik Login"  # quote multi-word values — fix-permissions.sh sources .env
# After setting the above, restart Vikunja and OIDC is live:
#   docker compose up -d --no-deps --force-recreate vikunja

# ╔══════════════════════════════════════════════════════════════════╗
# ║  ClickHouse — security analytics OLAP store                    ║
# ║  Docs: https://clickhouse.com/docs                             ║
# ╚══════════════════════════════════════════════════════════════════╝
CLICKHOUSE_PASSWORD=                  # Admin/your-org user password — gen-secrets.py fills this
CLICKHOUSE_VECTOR_PASSWORD=           # Dedicated write-only password for Vector log ingestion
CLICKHOUSE_SUBDOMAIN=ch               # Subdomain for ClickHouse UI (served via Caddy when enabled)

# ╔══════════════════════════════════════════════════════════════════╗
# ║  Zeek — network security monitoring                            ║
# ║  Docs: https://docs.zeek.org                                   ║
# ╚══════════════════════════════════════════════════════════════════╝
# auto = monitor all non-loopback interfaces; or comma-list: eth0,eth1
ZEEK_INTERFACES=auto

# ╔══════════════════════════════════════════════════════════════════╗
# ║  Media VPN — Gluetun + ProtonVPN WireGuard                    ║
# ║  Profile: media  |  Docs: https://github.com/qdm12/gluetun    ║
# ╚══════════════════════════════════════════════════════════════════╝
# GOTCHA: MEDIA_PATH and DOWNLOADS_PATH must exist on the host
#   before starting the stack. docker-host-config.sh creates them
#   but they need physical storage mounted there.
# GOTCHA: GPU transcoding (/dev/dri) requires a compatible GPU and
#   drivers (intel-media-va-driver for Intel, libva-mesa-driver for AMD).
# WIREGUARD_PRIVATE_KEY: the PrivateKey line from your ProtonVPN WG config
#   (ProtonVPN dashboard → Downloads → WireGuard configuration).
DOWNLOADS_PATH=/dock/tor
MEDIA_PATH=/dock/media
PROTONVPN_PORT_FORWARDING=off          # Set to "on" to enable port forwarding for seeding.
                                        # If enabled, QBIT_WEBUI_PORT must match the port number in
                                        # Gluetun's VPN_PORT_FORWARDING_UP_COMMAND env var in docker-compose.yml.
PROTONVPN_SERVER_COUNTRIES=Netherlands
PROTONVPN_WIREGUARD_PRIVATE_KEY=
QBIT_WEBUI_PORT=8080                   # qBittorrent web UI port. Must match Gluetun's port-forwarding
                                        # command if PROTONVPN_PORT_FORWARDING=on.

# ════════════════════════════════════════════════════════════════════
#   PERFORMANCE TIERING — per-service memory presets (OPTIONAL guidance)
#   run.sh auto-detects RESOURCE_TIER (see top of file) from host RAM:
#   ≤12→MICRO, ≤20→LOW, ≤44→MED, ≤96→HIGH, else MAX. These presets are
#   NOT auto-applied — map your detected tier to a block and uncomment it:
#     MAX / HIGH  → keep the active (HIGH) block below as-is.
#     MED         → comment the HIGH block, uncomment the MED block.
#     LOW         → comment the HIGH block, uncomment the LOW block.
#     MICRO       → uncomment the LOW block AND trim STACK_PROFILES toward core-only.
#   run.sh warns if the active block's memory ceiling exceeds host RAM.
#   (Tiers scale per-service *_MEM_LIMIT only; they do not change which services run.)
# ════════════════════════════════════════════════════════════════════

# Default per-container CPU quota applied by the x-hardened anchor to every
# hardened service that does not set its own `cpus:`. STABILITY cap (prevents a
# single runaway container from starving the scheduler -> autoheal restart storm).
# Generous default; raise on big hosts, lower (e.g. 1) on a 4-core LOW-tier box.
DEFAULT_CPU_LIMIT=2

# ---------- HIGH tier (active) ----------
POSTGRES_MEM_LIMIT=8g
POSTGRES_CPUS=4
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAX_CONNECTIONS=300
REDIS_MEM_LIMIT=4g
REDIS_MAXMEMORY=3584mb
REDIS_IO_THREADS=4
REDIS_AFFINE_MEM_LIMIT=512m
CADDY_MEM_LIMIT=2g
CADDY_CPUS=2
CROWDSEC_MEM_LIMIT=1g
TORPROXY_MEM_LIMIT=256m
CLICKHOUSE_MEM_LIMIT=4g
VECTOR_MEM_LIMIT=512m
AUTHENTIK_SERVER_MEM_LIMIT=2g
AUTHENTIK_WORKER_MEM_LIMIT=2g
BAO_MEM_LIMIT=512m                # core secrets backend; small + fixed (not tier-scaled)
NEXTCLOUD_MEM_LIMIT=2g
NOTIFY_PUSH_MEM_LIMIT=128m            # notify_push daemon (Client Push) — tiny Rust binary
FALCO_MEM_LIMIT=1g
ZEEK_MEM_LIMIT=2g
ZEEK_WORKER_COUNT=4
# Media stack
GLUETUN_MEM_LIMIT=256m
PROWLARR_MEM_LIMIT=512m
RADARR_MEM_LIMIT=512m
SONARR_MEM_LIMIT=512m
LIDARR_MEM_LIMIT=512m
FLARESOLVERR_MEM_LIMIT=512m
QBIT_MEM_LIMIT=1g
JELLYFIN_MEM_LIMIT=4g
JELLYSEERR_MEM_LIMIT=512m
# Productivity stack
NTFY_MEM_LIMIT=256m
TANDOOR_MEM_LIMIT=512m
VIKUNJA_MEM_LIMIT=512m
AFFINE_MEM_LIMIT=2g
COTURN_MEM_LIMIT=256m
N8N_MEM_LIMIT=1g

