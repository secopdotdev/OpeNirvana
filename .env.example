# ==========================================================
# GLOBAL — applies to all/most containers
# ==========================================================
COMPOSE_PROJECT_NAME=stack
PUID=1010
PGID=1010
TZ=America/Chicago
PUBLIC_FQDN=yourdomain.com           # the zone Cloudflare manages
TAILNET_FQDN=your-tailnet.ts.net     # from Tailscale admin → DNS
ADMIN_EMAIL=you@yourdomain.com

# Host paths (must match docker-host-config.sh tree)
DOCK_CONF=/dock/conf
DOCK_DATA=/dock/data
DOCK_DB=/dock/db
DOCK_TAIL=/dock/tail

# External IPs outside Cloudflare permitted to reach *.PUBLIC_FQDN
# Useful for a home/office IP; leave blank to allow no extra IPs.
EXTRA_ALLOWED_IP=

# ==========================================================
# RESOURCE LIMITS — uncomment ONE tier block
# HIGH: 64GB+/16+ cores | MED: 16-32GB/8 cores | LOW: 8GB/4 cores
# ==========================================================
# ---------- HIGH tier (active) ----------
POSTGRES_MEM_LIMIT=8g
POSTGRES_CPUS=4
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAX_CONNECTIONS=300
REDIS_MEM_LIMIT=4g
REDIS_MAXMEMORY=3584mb
REDIS_IO_THREADS=4
CADDY_MEM_LIMIT=2g
CADDY_CPUS=2
CROWDSEC_MEM_LIMIT=1g
AUTHENTIK_SERVER_MEM_LIMIT=2g
AUTHENTIK_WORKER_MEM_LIMIT=2g
NEXTCLOUD_MEM_LIMIT=2g
WAZUH_INDEXER_MEM_LIMIT=8g
WAZUH_INDEXER_JVM_HEAP=4g
WAZUH_MANAGER_MEM_LIMIT=2g
WAZUH_DASHBOARD_MEM_LIMIT=1g
FALCO_MEM_LIMIT=1g
ZEEK_MEM_LIMIT=2g
ZEEK_WORKER_COUNT=4
# Media stack
GLUETUN_MEM_LIMIT=256m
PROWLARR_MEM_LIMIT=512m
RADARR_MEM_LIMIT=512m
SONARR_MEM_LIMIT=512m
LIDARR_MEM_LIMIT=512m
FLARESOLVERR_MEM_LIMIT=512m
QBIT_MEM_LIMIT=1g
JELLYFIN_MEM_LIMIT=4g
JELLYSEERR_MEM_LIMIT=512m
# Productivity stack
NTFY_MEM_LIMIT=256m
TANDOOR_MEM_LIMIT=512m
VIKUNJA_MEM_LIMIT=512m
AFFINE_MEM_LIMIT=2g
COTURN_MEM_LIMIT=256m
N8N_MEM_LIMIT=1g

