{
  "uid": "obs-security",
  "title": "Observability \u00b7 Security & Auth",
  "tags": [
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Authentik logins (Loki)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({container=\"authentik-server\"} |~ `(?i)login.*success`[10m]))",
          "refId": "A",
          "legendFormat": "success"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({container=\"authentik-server\"} |~ `(?i)(login.*fail|invalid)`[10m]))",
          "refId": "B",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Auth failures vs anomaly band",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({container=\"authentik-server\"} |~ `(?i)fail`[5m]))",
          "refId": "A",
          "legendFormat": "failed"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "avg_over_time((sum(rate({container=\"authentik-server\"} |~ `(?i)fail`[5m])))[1h:5m])",
          "refId": "B",
          "legendFormat": "avg(1h)"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "avg_over_time((sum(rate({container=\"authentik-server\"} |~ `(?i)fail`[5m])))[1h:5m]) + 3 * stddev_over_time((sum(rate({container=\"authentik-server\"} |~ `(?i)fail`[5m])))[1h:5m])",
          "refId": "C",
          "legendFormat": "+3\u03c3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "CrowdSec active decisions",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(cs_active_decisions) or vector(0)",
          "refId": "A",
          "legendFormat": "active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Fleet errors by container (top 8)",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(8, sum by (container) (rate({container=~\".+\"} |~ `(?i)error`[5m])))",
          "refId": "A",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "logs",
      "title": "Recent critical errors",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\".+\"} |~ `(?i)fatal|panic|critical`",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "id": 5
    }
  ]
}
