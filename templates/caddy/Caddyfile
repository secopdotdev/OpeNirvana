{
    admin :2019
    email {$ADMIN_EMAIL}
    # Unordered plugin handlers — pin to the standard pipeline so named
    # snippets can import them outside of explicit route blocks.
    order crowdsec first
    order coraza_waf after crowdsec
    log default {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 10
            roll_keep_for 720h
        }
        format json
        level {$CADDY_LOG_LEVEL}
    }

    # NOTE: global `metrics` is the prime suspect for the WebSocket bug —
    # its response instrumentation wraps WriteHeader, which collides with
    # reverse_proxy's HTTP/1.1 101 hijack for WS upgrades. Caddy logs
    # "superfluous response.WriteHeader call from metrics.go:77" on every
    # request, and on WS the 101 status line never reaches the client.
    # Disabled until we either pin Caddy to a version that fixes it or
    # move Prometheus scraping to a non-instrumenting source.
    # metrics

    servers {
        protocols h1 h2 h3
        trusted_proxies cloudflare {
            interval 12h
            timeout 15s
        }
    }

    # NOTE: global `cache` (Souin) wraps every ResponseWriter to intercept
    # responses for caching. It does not handle the Hijack() that
    # reverse_proxy performs on WS upgrades, which corrupts the HTTP/1.1
    # 101 Switching Protocols response (browser sees raw WS frames, CF
    # returns 520). Re-enable per-site for cacheable endpoints only.
    # cache {
    #     ttl 10m
    #     api {
    #         basepath /souin-api
    #     }
    #     redis {
    #         url redis://:{$REDIS_PASSWORD}@redis:6379/{$REDIS_DB_CADDY_CACHE}
    #     }
    # }

    crowdsec {
        api_url http://crowdsec:8080
        api_key {$CROWDSEC_BOUNCER_API_KEY}
        ticker_interval 15s
    }

    storage redis {
        host       redis
        port       6379
        password   {$REDIS_PASSWORD}
        db         {$REDIS_DB_CADDY_TLS}
        key_prefix caddy_tls
        tls_enabled false
    }

    security {
        authorization policy m2m_api_policy {
            crypto key verify from env CADDY_JWT_SHARED_SECRET
            validate bearer header
            allow roles api_client
            disable auth redirect
        }
    }
}

# Pull named-snippet definitions from individual files under snippets/.
import snippets/*.caddy

# ==============================================================
# Backend snippets — one per routed service.
#
# Adding a service:
#   1. Define (backend-myservice) here with the upstream only.
#      Authentik auth is enforced by the bare forward_auth directive at the
#      site level (runs before handle blocks). Do NOT add import
#      authentik-forward-auth inside backend snippets.
#   2. Add @myservice matcher + handle block in BOTH site blocks below.
#   3. Add MYSERVICE_SUBDOMAIN=foo to .env and to caddy's environment
#      block in docker-compose.yml.
#   4. If the service is on a new network, ensure tailscale-ingress is
#      also connected to that network (caddy shares tailscale-ingress's
#      netns so it inherits its reachability).
# ==============================================================

# Authentik SSO — the identity provider itself; exempt from the global gate.
(backend-authentik) {
    reverse_proxy authentik-server:9000 {
        flush_interval -1
    }
}

# Dashy — home launcher served at the apex domain.
(backend-dashy) {
    reverse_proxy dashy:8080
}

# Grafana — metrics + health dashboards (WebSocket for Grafana Live).
(backend-grafana) {
    reverse_proxy grafana:3000 {
        flush_interval -1
    }
}

# Nextcloud — file sync + collaboration.
# Well-known redirects are required by CalDAV/CardDAV clients.
# Served from a dedicated cloud.* site (below), NOT the *.{PUBLIC_FQDN}
# wildcard, so the notify_push /push/* WebSocket can bypass the response-
# wrapping middleware (coraza/security-headers) that breaks the WS hijack.
(backend-nextcloud) {
    redir /.well-known/carddav /remote.php/dav 301
    redir /.well-known/caldav  /remote.php/dav 301

    reverse_proxy nextcloud:80
}

