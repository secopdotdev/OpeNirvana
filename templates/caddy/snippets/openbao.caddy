# OpenBao secrets backend — dedicated site blocks.
#
# WHY a dedicated site block (not the *.{$PUBLIC_FQDN} wildcard):
#   The wildcard's @requires-auth-pub matcher excludes known OIDC-native apps by
#   host. Adding bao.* to that exclusion list would require editing the main
#   Caddyfile. A dedicated exact-host site block is self-contained, ships with
#   the openbao snippet, and beats the wildcard for routing — no Caddyfile edit
#   required. Exact same rationale as talk.* and cloud.* above.
#
# WebSocket: OpenBao core UI does NOT use WebSocket for any primary flow
#   (no live-push, no Upgrade requests). The response-wrapping middleware
#   (coraza WAF + security-headers) is safe to apply — no WS gotcha applies
#   here. A dedicated block is used for the auth self-containment reason above,
#   not for WS bypass.
#
# Auth: OpenBao is admin-only infrastructure. Every request (public and tailnet)
#   goes through Authentik forward-auth — there is NO exclusion from the gate.
#   Unlike OIDC-native apps (Jellyfin, Immich) that own their login page,
#   OpenBao's UI is a pure SPA that expects to talk directly to the API; the
#   Authentik gate sits in front at the Caddy layer, so the SPA is only ever
#   reached by an authenticated session.

# ==============================================================
# Public ingress: bao.{$PUBLIC_FQDN}
# TLS via Cloudflare DNS-01 — shares the wildcard cert pool.
# ==============================================================
{$BAO_SUBDOMAIN}.{$PUBLIC_FQDN} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }

    import public-policy

    # Authentik outpost callback paths must reach authentik-proxy directly to
    # complete the OAuth/OIDC login flow before the user is redirected back.
    @outpost-bao-pub {
        path /outpost.goauthentik.io/*
    }
    handle @outpost-bao-pub {
        reverse_proxy authentik-proxy:9000
    }

    # All remaining traffic requires a valid Authentik session.
    # OpenBao is admin-only infrastructure — no exclusions.
    forward_auth authentik-proxy:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
    }

    reverse_proxy openbao:8200
}

# ==============================================================
# Tailnet ingress: bao.{$TAILNET_FQDN}
# http:// prefix — Tailscale Serve terminates TLS in front of Caddy;
# Caddy listens on :80 inside the tailscale-ingress netns.
# ==============================================================
http://{$BAO_SUBDOMAIN}.{$TAILNET_FQDN} {
    import tailnet-policy

    # Authentik outpost callback paths (tailnet variant).
    @outpost-bao-ts {
        path /outpost.goauthentik.io/*
    }
    handle @outpost-bao-ts {
        reverse_proxy authentik-proxy:9000
    }

    # All remaining traffic requires a valid Authentik session.
    forward_auth authentik-proxy:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
    }

    reverse_proxy openbao:8200
}
