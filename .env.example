# ╔══════════════════════════════════════════════════════════════════╗
# ║  Pinned image versions                                            ║
# ║  Each service's image tag is ${<SERVICE>_VERSION:-<default>} so   ║
# ║  upgrades are deliberate. `maintain.py versions` (and run.sh)     ║
# ║  report newer upstream releases; the Grafana "Image updates       ║
# ║  available" table lists them. Bump a value here, then             ║
# ║  `docker compose up -d <service>` to upgrade. Repos shown for     ║
# ║  where to find versions (GitHub releases / Docker Hub tags).      ║
# ╚══════════════════════════════════════════════════════════════════╝
SOCKET_PROXY_VERSION=v0.4.2           # github Tecnativa/docker-socket-proxy
COTURN_VERSION=4.11.0-r0              # github coturn/coturn
ZEEK_VERSION=8.1.1                    # github zeek/zeek
FLARESOLVERR_VERSION=v3.4.6           # github FlareSolverr/FlareSolverr
PROWLARR_VERSION=2.3.5.5327-ls144     # github Prowlarr/Prowlarr (linuxserver tag)
RADARR_VERSION=6.1.1.10360-ls300      # github Radarr/Radarr (linuxserver tag)
SONARR_VERSION=4.0.17.2952-ls309      # github Sonarr/Sonarr (linuxserver tag)
LIDARR_VERSION=3.1.0.4875-ls26        # github Lidarr/Lidarr (linuxserver tag)
QBIT_VERSION=5.1.4-r3-ls452    # github qbittorrent/qBittorrent (linuxserver tag)
FILEBROWSER_VERSION=v2.63.5           # github filebrowser/filebrowser (zeek-logs)
REDIS_EXPORTER_VERSION=v1.84.0        # github oliver006/redis_exporter
# NOTE: services running rolling tags (tailscale, gluetun, autoheal,
# jellyseerr, ntfy, cadvisor, node-exporter, postgres-exporter,
# falcosidekick) still use :latest — the version monitor surfaces their current
# release so you can add a <SERVICE>_VERSION pin here when ready.

# ════════════════════════════════════════════════════════════════════
#   OpenBao — secrets backend of record (ADR 0001)
#   Secrets are generated into OpenBao KV v2; .env is compiled from it
#   by bao-sync.py at deploy time. See docs/openbao-runbook.md.
# ════════════════════════════════════════════════════════════════════
BAO_SUBDOMAIN=bao                     # bao.PUBLIC_FQDN (Caddy+Authentik) and bao.TAILNET_FQDN (Tailscale)
BAO_KV_MOUNT=secret                   # KV v2 mount path
BAO_APPROLE_NAME=env-sync             # AppRole bao-sync logs in as
# AppRole creds emitted by bao-bootstrap.py (write-if-blank). Do NOT hand-edit.
BAO_SYNC_ROLE_ID=
BAO_SYNC_SECRET_ID=
# --- Survivable key custody (ADR 0001 §"Defusing the D7 landmine") ---
# Provide ONE of: an age recipient for encrypted escrow, OR the AKV auto-unseal block.
# If BOTH are blank on an unattended deploy, bao-bootstrap emits a loud warning that
# recovery keys exist only on this host and MUST be copied off-box.
BAO_ESCROW_AGE_RECIPIENT=             # age public key; bao-bootstrap writes init.json.age escrow copy
BAO_AKV_TENANT_ID=                    # optional Azure Key Vault auto-unseal (recommended prod posture)
BAO_AKV_CLIENT_ID=
BAO_AKV_CLIENT_SECRET=
BAO_AKV_VAULT_NAME=
BAO_AKV_KEY_NAME=
