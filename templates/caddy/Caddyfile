# nextcloud-spreed-signaling — HPB WebSocket signaling server.
# Not behind Authentik: Nextcloud Talk clients connect directly via WebSocket.
# transport http versions 1.1 — force HTTP/1.1 upstream so the WS Upgrade
# header reaches spreed-signaling and the 101 response is forwarded
# verbatim. Without this, Caddy may negotiate h2 to upstream where the
# Upgrade semantics don't apply, breaking the handshake.
(backend-spreed-signaling) {
    reverse_proxy spreed-signaling:8080 {
        flush_interval -1
        transport http {
            versions 1.1
        }
    }
}

# Janus Gateway — WebRTC media server admin API.
# Gated by Authentik. Janus API (8088) is internal-only; this exposes admin (8188).
(backend-janus) {
    reverse_proxy janus:8188
}

# ==============================================================
# Reusable security policy blocks.
# ==============================================================

(public-policy) {
    import cloudflare-allowlist
    import crowdsec
    import coraza
    import security-headers
}

(tailnet-policy) {
    import crowdsec
    import coraza
    import security-headers
}

# ==============================================================
# Nextcloud Talk HPB signaling — dedicated site, no middleware.
# Pure WebSocket pass-through. The public-policy block (coraza WAF +
# security-headers) corrupts the WS handshake response, producing
# "superfluous WriteHeader" in Caddy logs and HTTP 520 at Cloudflare.
# Exact-host site beats the *.{PUBLIC_FQDN} wildcard for routing.
# Auth is enforced by spreed-signaling's [backend] shared-secret check.
# ==============================================================
{$TALK_SUBDOMAIN}.{$PUBLIC_FQDN} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
        import cf-origin-mtls
    }
    # crowdsec http wraps every ResponseWriter to check IPs against LAPI;
    # like the other instrumenting modules it breaks Hijack() on a WS 101
    # upgrade. The shared-secret check in spreed-signaling's [backend] is
    # the only meaningful auth boundary on this endpoint anyway.
    import backend-spreed-signaling
}

{$TALK_SUBDOMAIN}.{$TAILNET_FQDN} {
    tls {
        get_certificate tailscale
    }
    import backend-spreed-signaling
}

# ==============================================================
# OpenBao secrets backend — dedicated site blocks (inline, like talk.* above).
# Admin-only: every request goes through Authentik forward-auth, no exclusions.
# Inlined here rather than as a snippets/*.caddy file because it imports the
# (public-policy)/(tailnet-policy) snippets defined just above — a site block
# pulled in by the early `import snippets/*.caddy` would reference those
# snippets before they are defined (Caddy: "File to import not found").
# ==============================================================
{$BAO_SUBDOMAIN}.{$PUBLIC_FQDN} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
        import cf-origin-mtls
    }

    import public-policy

    # Authentik outpost callback paths must reach authentik-proxy directly to
    # complete the OAuth/OIDC login flow before the user is redirected back.
    @outpost-bao-pub {
        path /outpost.goauthentik.io/*
    }
    handle @outpost-bao-pub {
        reverse_proxy authentik-proxy:9000
    }

    # All remaining traffic requires a valid Authentik session.
    forward_auth authentik-proxy:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
    }

    reverse_proxy openbao:8200
}

http://{$BAO_SUBDOMAIN}.{$TAILNET_FQDN} {
    import tailnet-policy

    @outpost-bao-ts {
        path /outpost.goauthentik.io/*
    }
    handle @outpost-bao-ts {
        reverse_proxy authentik-proxy:9000
    }

    forward_auth authentik-proxy:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
    }

    reverse_proxy openbao:8200
}

# ==============================================================
# Nextcloud — dedicated site (NOT the *.{FQDN} wildcard) so the
# notify_push Client Push WebSocket at /push/ws can bypass the
# response-wrapping middleware (coraza WAF + security-headers)
# that corrupts the WS 101 hijack — the same root cause that
# forced talk.* onto its own site. Nextcloud's own traffic still
# gets the full security stack via the inner handle block; only
# /push/* is exempt. Exact-host beats the wildcard for routing.
# Nextcloud is not behind Authentik (it owns its own login +
# user_oidc), so no forward_auth here. notify_push:setup keeps
# the conventional https://<cloud>/push endpoint.
# ==============================================================
{$NEXTCLOUD_SUBDOMAIN}.{$PUBLIC_FQDN} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
        import cf-origin-mtls
    }

    handle_path /push/* {
        reverse_proxy notify-push:7867 {
            flush_interval -1
        }
    }

    handle {
        # Nextcloud ships its own nonce-based CSP; use the CSP-less base so
        # Caddy doesn't overwrite it with a strict default-src that blocks
        # NC's inline styles/scripts. (crowdsec + coraza still apply.)
        import crowdsec
        import coraza
        import security-headers-base
        import backend-nextcloud
    }
}

{$NEXTCLOUD_SUBDOMAIN}.{$TAILNET_FQDN} {
    tls {
        get_certificate tailscale
    }

    handle_path /push/* {
        reverse_proxy notify-push:7867 {
            flush_interval -1
        }
    }

    handle {
        import crowdsec
        import coraza
        import security-headers-base
        import backend-nextcloud
    }
}

# ==============================================================
# Authentik SSO server - dedicated site to avoid Coraza WAF /
# CrowdSec ResponseWriter wrapping which breaks WebSocket hijack
# on /ws/outpost/*. See comments at talk.* block for rationale.
# ==============================================================
{$AUTHENTIK_SUBDOMAIN}.{$PUBLIC_FQDN} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
        import cf-origin-mtls
    }
    import backend-authentik
}

# ==============================================================
# Public ingress: *.{$PUBLIC_FQDN}   (e.g. *.example.com)
# TLS via Cloudflare DNS-01 challenge — single wildcard cert.
# All unmatched hosts abort (no default backend).
# ==============================================================
*.{$PUBLIC_FQDN} {
    import public-policy

    # Services that set their own richer CSP — strip ours so it doesn't
    # override theirs. Must be at site level (after the import) so it
    # runs after security-headers adds the header.
    header @jellyfin-pub -Content-Security-Policy
    header @couchdb-pub  -Content-Security-Policy
    header @vikunja-pub  -Content-Security-Policy
    header @tandoor-pub  -Content-Security-Policy
    header @immich       -Content-Security-Policy
    header @n8n-pub      -Content-Security-Policy
    header @janus-pub    -Content-Security-Policy
    header @ntfy-pub     -Content-Security-Policy

    # FileBrowser (Zeek log viewer) bootstraps the SPA from an inline
    # <script> that sets window.FileBrowser; the global default-src 'self'
    # CSP blocks it, leaving the config undefined and the page fully blank.
    # Dedicated matcher (not the @zeek routing matcher) so the strip also
    # applies to the forward_auth response.
    @zeek-pub host {$ZEEK_SUBDOMAIN}.{$PUBLIC_FQDN}
    header @zeek-pub -Content-Security-Policy

    # Komodo SPA uses inline scripts/styles for dashboard panels.
    @komodo-pub host {$KOMODO_SUBDOMAIN}.{$PUBLIC_FQDN}
    header @komodo-pub -Content-Security-Policy

    # Grafana uses inline scripts/styles in dashboard panels.
    @grafana-pub host {$GRAFANA_SUBDOMAIN}.{$PUBLIC_FQDN}
    header @grafana-pub -Content-Security-Policy

    # ClickHouse /play UI uses inline scripts to render result tables.
    @clickhouse-pub host {$CLICKHOUSE_SUBDOMAIN}.{$PUBLIC_FQDN}
    header @clickhouse-pub -Content-Security-Policy

    # Media *arr apps and qBittorrent use inline scripts/styles.
    @media host {$PROWLARR_SUBDOMAIN}.{$PUBLIC_FQDN} {$RADARR_SUBDOMAIN}.{$PUBLIC_FQDN} {$SONARR_SUBDOMAIN}.{$PUBLIC_FQDN} {$LIDARR_SUBDOMAIN}.{$PUBLIC_FQDN} {$QBIT_SUBDOMAIN}.{$PUBLIC_FQDN}
    header @media -Content-Security-Policy

    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
        import cf-origin-mtls
    }

    # ── Global Authentik gate ──────────────────────────────────────────────
    # forward_auth is a directive-level handler that runs BEFORE handle blocks
    # in Caddy's standard directive ordering. The combined matcher excludes:
    #   (a) example.com — the identity provider itself
    #   (b) /outpost.goauthentik.io/* — OAuth callback/flow paths that must
    #       reach authentik-proxy directly to complete the login sequence.
    # A separate handle block routes outpost paths to authentik-proxy;
    # it runs after forward_auth but forward_auth skips those paths via (b).
    @outpost-pub {
        not host {$AUTHENTIK_SUBDOMAIN}.{$PUBLIC_FQDN}
        path /outpost.goauthentik.io/*
    }
    handle @outpost-pub {
        reverse_proxy authentik-proxy:9000
    }

    @requires-auth-pub {
        not host {$AUTHENTIK_SUBDOMAIN}.{$PUBLIC_FQDN}
        not host {$NEXTCLOUD_SUBDOMAIN}.{$PUBLIC_FQDN}
        not host {$VIKUNJA_SUBDOMAIN}.{$PUBLIC_FQDN}
        not host {$COUCHDB_SUBDOMAIN}.{$PUBLIC_FQDN}
        not host {$TANDOOR_SUBDOMAIN}.{$PUBLIC_FQDN}
        not host {$TALK_SUBDOMAIN}.{$PUBLIC_FQDN}
        # Native OIDC + mobile/API clients — app owns its own login page.
        not host {$JELLYFIN_SUBDOMAIN}.{$PUBLIC_FQDN}
        not host {$IMMICH_SUBDOMAIN}.{$PUBLIC_FQDN}
        not host {$NTFY_SUBDOMAIN}.{$PUBLIC_FQDN}
        not path /outpost.goauthentik.io/*
    }
    forward_auth @requires-auth-pub authentik-proxy:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
    }
    # ──────────────────────────────────────────────────────────────────────


    # cloud.{$PUBLIC_FQDN} is handled by its dedicated site block above (so the
    # notify_push /push/* WebSocket can bypass response middleware) — the
    # wildcard never matches that host now.

    @prowlarr host {$PROWLARR_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @prowlarr {
        import backend-prowlarr
    }

    @radarr host {$RADARR_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @radarr {
        import backend-radarr
    }

    @sonarr host {$SONARR_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @sonarr {
        import backend-sonarr
    }

    @lidarr host {$LIDARR_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @lidarr {
        import backend-lidarr
    }

    @qbittorrent host {$QBIT_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @qbittorrent {
        import backend-qbittorrent
    }

    @jellyfin-pub host {$JELLYFIN_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @jellyfin-pub {
        import backend-jellyfin
    }

    @jellyseerr host {$JELLYSEERR_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @jellyseerr {
        import backend-jellyseerr
    }

    @ntfy-pub host {$NTFY_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @ntfy-pub {
        import backend-ntfy
    }

    @tandoor-pub host {$TANDOOR_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @tandoor-pub {
        # /setup/ is Tandoor's first-run superuser wizard — gate it even though
        # the rest of Tandoor uses native OIDC and skips forward_auth.
        @tandoor-setup path /setup/ /setup
        forward_auth @tandoor-setup authentik-proxy:9000 {
            uri /outpost.goauthentik.io/auth/caddy
            copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid
        }
        import backend-tandoor
    }

    @vikunja-pub host {$VIKUNJA_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @vikunja-pub {
        import backend-vikunja
    }

    @couchdb-pub host {$COUCHDB_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @couchdb-pub {
        # Fauxton admin UI is browser-accessible -> gate it with Authentik.
        # The sync API (everything else on this host) is intentionally NOT
        # forward-auth'd — obsidian-livesync uses CouchDB native account auth.
        @fauxton-pub path /_utils /_utils/*
        forward_auth @fauxton-pub authentik-proxy:9000 {
            uri /outpost.goauthentik.io/auth/caddy
            copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid
        }
        import backend-couchdb
    }

    @flaresolverr host {$FLARESOLVERR_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @flaresolverr {
        import backend-flaresolverr
    }

    @crowdsec host {$CROWDSEC_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @crowdsec {
        import backend-crowdsec
    }

    @immich host {$IMMICH_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @immich {
        import backend-immich
    }

    @falco host {$FALCO_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @falco {
        import backend-falco
    }

    @zeek host {$ZEEK_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @zeek {
        import backend-zeek
    }

    @n8n-pub host {$N8N_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @n8n-pub {
        import backend-n8n
    }

    # talk.{$PUBLIC_FQDN} is handled by its dedicated site block above —
    # the *.{$PUBLIC_FQDN} wildcard never matches that host now.

    @janus-pub host {$JANUS_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @janus-pub {
        import backend-janus
    }

    @grafana host {$GRAFANA_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @grafana {
        import backend-grafana
    }

    @clickhouse host {$CLICKHOUSE_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @clickhouse {
        import backend-clickhouse
    }

    @komodo host {$KOMODO_SUBDOMAIN}.{$PUBLIC_FQDN}
    handle @komodo {
        import backend-komodo
    }

    # Catch-all: reject any subdomain not explicitly matched above.
    handle {
        abort
    }
}

# ==============================================================
# Tailnet ingress: *.{$TAILNET_FQDN}   (e.g. *.your-tailnet.example)
# http:// prefix — Tailscale Serve terminates TLS in front of Caddy;
# Caddy listens on :80 inside the tailscale-ingress netns.
# Without http://, Caddy's auto-HTTPS tries on-demand certs for every
# tailnet subdomain and blocks startup in Caddy 2.11+.
# ==============================================================
http://*.{$TAILNET_FQDN} {
    import tailnet-policy

    header @authentik    -Content-Security-Policy
    header @jellyfin-ts  -Content-Security-Policy
    header @couchdb-ts   -Content-Security-Policy
    header @vikunja-ts   -Content-Security-Policy
    header @tandoor-ts   -Content-Security-Policy
    header @immich-ts    -Content-Security-Policy
    header @n8n-ts       -Content-Security-Policy
    header @ntfy-ts      -Content-Security-Policy

    @zeek-ts-pub host {$ZEEK_SUBDOMAIN}.{$TAILNET_FQDN}
    header @zeek-ts-pub -Content-Security-Policy

    @komodo-ts-pub host {$KOMODO_SUBDOMAIN}.{$TAILNET_FQDN}
    header @komodo-ts-pub -Content-Security-Policy

    @grafana-ts-pub host {$GRAFANA_SUBDOMAIN}.{$TAILNET_FQDN}
    header @grafana-ts-pub -Content-Security-Policy

    @clickhouse-ts-pub host {$CLICKHOUSE_SUBDOMAIN}.{$TAILNET_FQDN}
    header @clickhouse-ts-pub -Content-Security-Policy

    @media host {$PROWLARR_SUBDOMAIN}.{$TAILNET_FQDN} {$RADARR_SUBDOMAIN}.{$TAILNET_FQDN} {$SONARR_SUBDOMAIN}.{$TAILNET_FQDN} {$LIDARR_SUBDOMAIN}.{$TAILNET_FQDN} {$QBIT_SUBDOMAIN}.{$TAILNET_FQDN}
    header @media -Content-Security-Policy

    # ── Global Authentik gate (Tailnet) ───────────────────────────────────
    @outpost-ts {
        not host {$AUTHENTIK_SUBDOMAIN}.{$TAILNET_FQDN}
        path /outpost.goauthentik.io/*
    }
    handle @outpost-ts {
        reverse_proxy authentik-proxy:9000
    }

    @requires-auth-ts {
        not host {$AUTHENTIK_SUBDOMAIN}.{$TAILNET_FQDN}
        not host {$NEXTCLOUD_SUBDOMAIN}.{$TAILNET_FQDN}
        not host {$VIKUNJA_SUBDOMAIN}.{$TAILNET_FQDN}
        not host {$COUCHDB_SUBDOMAIN}.{$TAILNET_FQDN}
        not host {$TANDOOR_SUBDOMAIN}.{$TAILNET_FQDN}
        not host {$TALK_SUBDOMAIN}.{$TAILNET_FQDN}
        # Native OIDC + mobile/API clients — app owns its own login page.
        not host {$JELLYFIN_SUBDOMAIN}.{$TAILNET_FQDN}
        not host {$IMMICH_SUBDOMAIN}.{$TAILNET_FQDN}
        not host {$NTFY_SUBDOMAIN}.{$TAILNET_FQDN}
        not path /outpost.goauthentik.io/*
    }
    forward_auth @requires-auth-ts authentik-proxy:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
    }
    # ──────────────────────────────────────────────────────────────────────

    @authentik host {$AUTHENTIK_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @authentik {
        import backend-authentik
    }

    # cloud.{$TAILNET_FQDN} is handled by its dedicated site block above (so the
    # notify_push /push/* WebSocket can bypass response middleware) — the
    # wildcard never matches that host now.

    @prowlarr host {$PROWLARR_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @prowlarr {
        import backend-prowlarr
    }

    @radarr host {$RADARR_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @radarr {
        import backend-radarr
    }

    @sonarr host {$SONARR_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @sonarr {
        import backend-sonarr
    }

    @lidarr host {$LIDARR_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @lidarr {
        import backend-lidarr
    }

    @qbittorrent host {$QBIT_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @qbittorrent {
        import backend-qbittorrent
    }

    @jellyfin-ts host {$JELLYFIN_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @jellyfin-ts {
        import backend-jellyfin
    }

    @jellyseerr host {$JELLYSEERR_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @jellyseerr {
        import backend-jellyseerr
    }

    @ntfy-ts host {$NTFY_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @ntfy-ts {
        import backend-ntfy
    }

    @tandoor-ts host {$TANDOOR_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @tandoor-ts {
        @tandoor-setup path /setup/ /setup
        forward_auth @tandoor-setup authentik-proxy:9000 {
            uri /outpost.goauthentik.io/auth/caddy
            copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid
        }
        import backend-tandoor
    }

    @vikunja-ts host {$VIKUNJA_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @vikunja-ts {
        import backend-vikunja
    }

    @couchdb-ts host {$COUCHDB_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @couchdb-ts {
        @fauxton-ts path /_utils /_utils/*
        forward_auth @fauxton-ts authentik-proxy:9000 {
            uri /outpost.goauthentik.io/auth/caddy
            copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid
        }
        import backend-couchdb
    }

    @flaresolverr-ts host {$FLARESOLVERR_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @flaresolverr-ts {
        import backend-flaresolverr
    }

    @crowdsec-ts host {$CROWDSEC_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @crowdsec-ts {
        import backend-crowdsec
    }

    @immich-ts host {$IMMICH_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @immich-ts {
        import backend-immich
    }

    @falco-ts host {$FALCO_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @falco-ts {
        import backend-falco
    }

    @zeek-ts host {$ZEEK_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @zeek-ts {
        import backend-zeek
    }

    @n8n-ts host {$N8N_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @n8n-ts {
        import backend-n8n
    }

    # talk.{$TAILNET_FQDN} is handled by its dedicated site block at the top —
    # the *.{$TAILNET_FQDN} wildcard never matches that host now.

    @janus-ts host {$JANUS_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @janus-ts {
        header -Content-Security-Policy
        import backend-janus
    }

    @grafana-ts host {$GRAFANA_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @grafana-ts {
        import backend-grafana
    }

    @clickhouse-ts host {$CLICKHOUSE_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @clickhouse-ts {
        import backend-clickhouse
    }

    @komodo-ts host {$KOMODO_SUBDOMAIN}.{$TAILNET_FQDN}
    handle @komodo-ts {
        import backend-komodo
    }

    # Catch-all: reject any subdomain not explicitly matched above.
    handle {
        abort
    }
}

# ==============================================================
# Apex public: {$PUBLIC_FQDN}   (e.g. example.com)
# Dashy launcher — Authentik-gated like all other services.
# Wildcard cert (*.{$PUBLIC_FQDN}) does NOT cover the apex, so
# a separate DNS-01 cert is issued for the bare domain.
# ==============================================================
{$PUBLIC_FQDN} {
    import public-policy

    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
        import cf-origin-mtls
    }

    @outpost-apex {
        path /outpost.goauthentik.io/*
    }
    handle @outpost-apex {
        reverse_proxy authentik-proxy:9000
    }

    @apex-needs-auth {
        not path /outpost.goauthentik.io/*
    }
    # Dashy is a Vue SPA — default-src 'self' blocks its bundled assets.
    # Matcher-based header removal compiles before the global security-headers
    # set route, ensuring the delete is the outer handler that finalizes last.
    header @apex-needs-auth -Content-Security-Policy
    forward_auth @apex-needs-auth authentik-proxy:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
    }

    handle {
        import backend-dashy
    }
}

# ==============================================================
# Apex tailnet: {$TAILNET_FQDN}   (e.g. your-tailnet.example)
# Dashy launcher on the bare tailnet domain — same Authentik gate.
# ==============================================================
http://{$TAILNET_FQDN} {
    import tailnet-policy

    @outpost-apex-ts {
        path /outpost.goauthentik.io/*
    }
    handle @outpost-apex-ts {
        reverse_proxy authentik-proxy:9000
    }

    @apex-ts-needs-auth {
        not path /outpost.goauthentik.io/*
    }
    header @apex-ts-needs-auth -Content-Security-Policy
    forward_auth @apex-ts-needs-auth authentik-proxy:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
    }

    handle {
        import backend-dashy
    }
}
