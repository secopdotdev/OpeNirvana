<group name="cloudflare,firewall,">

  <rule id="100500" level="0">
    <decoded_as>json</decoded_as>
    <location>/dock/conf/cloudflare/firewall-events.log</location>
    <description>Cloudflare firewall event</description>
  </rule>

  <rule id="100501" level="5">
    <if_sid>100500</if_sid>
    <match>"action":"challenge"</match>
    <description>Cloudflare challenged request from $(clientIP)</description>
    <group>challenge,</group>
  </rule>

  <rule id="100503" level="5">
    <if_sid>100500</if_sid>
    <match>"action":"jschallenge"</match>
    <description>Cloudflare JS challenged request from $(clientIP)</description>
    <group>challenge,</group>
  </rule>

  <rule id="100504" level="5">
    <if_sid>100500</if_sid>
    <match>"action":"managedChallenge"</match>
    <description>Cloudflare managed challenge for $(clientIP)</description>
    <group>challenge,</group>
  </rule>

  <rule id="100502" level="8">
    <if_sid>100500</if_sid>
    <match>"action":"block"</match>
    <description>Cloudflare blocked request from $(clientIP)</description>
    <group>block,</group>
  </rule>

  <rule id="100510" level="10">
    <if_sid>100502</if_sid>
    <match>"source":"waf"</match>
    <description>Cloudflare WAF block from $(clientIP): rule $(ruleId)</description>
    <group>block,waf,</group>
  </rule>

  <rule id="100511" level="9">
    <if_sid>100502</if_sid>
    <match>"source":"rateLimit"</match>
    <description>Cloudflare rate-limit block from $(clientIP)</description>
    <group>block,rate_limit,</group>
  </rule>

  <rule id="100512" level="7">
    <if_sid>100502</if_sid>
    <match>"source":"country"</match>
    <description>Cloudflare geo block from $(clientIP)</description>
    <group>block,geo,</group>
  </rule>

  <rule id="100513" level="7">
    <if_sid>100502</if_sid>
    <match>"source":"bic"</match>
    <description>Cloudflare browser-integrity block from $(clientIP)</description>
    <group>block,geo,</group>
  </rule>

  <rule id="100520" level="12" frequency="10" timeframe="600">
    <if_matched_sid>100502</if_matched_sid>
    <description>Cloudflare: 10+ blocks in 10 minutes</description>
    <group>block,recon,</group>
  </rule>

  <rule id="100599" level="3">
    <if_sid>100500</if_sid>
    <match>"events_fetched":</match>
    <description>Cloudflare poller heartbeat (events_fetched: $(events_fetched))</description>
    <group>heartbeat,</group>
  </rule>

</group>
